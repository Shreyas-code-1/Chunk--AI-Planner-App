# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# Only genuinely public values belong here: anything with the EXPO_PUBLIC_
# prefix is bundled into the app binary and is readable by anyone who
# downloads it. Secrets (the Supabase service role key, the Anthropic API key)
# live in Supabase Edge Functions and never appear in this file.

EXPO_PUBLIC_SUPABASE_URL=
# The publishable key (sb_publishable_...), not the legacy anon JWT.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
