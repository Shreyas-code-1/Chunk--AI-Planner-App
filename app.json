{
  "expo": {
    "name": "Chunk-",
    "slug": "Chunk-",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "chunk",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.caidenn2.chunk"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF9934",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.caidenn2.chunk"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FA7814",
          "image": "./assets/images/splash-native.png",
          "imageWidth": 390,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-audio",
      "expo-asset",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "caidenn2",
    "extra": {
      "eas": {
        "projectId": "805f0a5f-067f-4fbd-a278-935eebb94a1e"
      }
    }
  }
}
